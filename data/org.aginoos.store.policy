<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>agino</vendor>
  <vendor_url>https://aginoos.com</vendor_url>

  <action id="org.aginoos.store.manage">
    <description>Install, update and remove applications</description>
    <description xml:lang="zh_CN">安装、更新和卸载应用</description>
    <description xml:lang="zh_TW">安裝、更新和移除應用程式</description>
    <description xml:lang="zh_HK">安裝、更新和移除應用程式</description>
    <message>Authentication is required to install, update or remove applications</message>
    <message xml:lang="zh_CN">安装、更新或卸载应用需要认证</message>
    <message xml:lang="zh_TW">安裝、更新或移除應用程式需要認證</message>
    <message xml:lang="zh_HK">安裝、更新或移除應用程式需要認證</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
