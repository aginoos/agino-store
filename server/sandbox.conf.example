# agino-store-sandbox configuration (docs/sandbox.md). No secrets: the signing key is only a path.
[sandbox]
queue = /srv/store/sandbox/queue          # <app>_<sha12>.json + .deb pairs written by the server
state = /srv/store/sandbox/state          # <name>.json per finished or failed attempt
run = /srv/store/sandbox/run              # slot locks and per-slot run directories
shot_dir = /srv/store/sandbox/shots       # <name>.png of the launch check, host-side only
shots = on                                # on | off: store screenshots (docs/sandbox.md section 7)
shots_out = /srv/store/sandbox/shots-out  # <app>_<sha12>/<lang>/<n>-<scene>.png + shots.json
corner_radius = 8                         # px, transparent rounded corners of the cropped window
screen = 1920x1080                        # virtio-vga xres x yres
reports = /srv/store/reports              # signed <name>.json + <name>.json.sig
base = /srv/store/sandbox/base/current.qcow2
ovmf_code = /usr/share/OVMF/OVMF_CODE_4M.fd
base_vars = /srv/store/sandbox/base/current.vars   # the base image's own UEFI NVRAM (boot entry), copied per run
key = /etc/agino-store-sandbox/report.pem  # Ed25519 private key (PEM), owned by agino-sandbox, mode 0600
qemu = qemu-system-x86_64
qemu_img = qemu-img
qemu_sandbox = auto                       # auto | on | off (qemu -sandbox)
slots = 4                                 # 1..4, tap devices agsbx-t0..t3
memory_mb = 4096
cpus = 4

# Interactive screenshot sessions (docs/sandbox.md section 9). Optional; these are the defaults.
[session]
runtime_dir = /run/agino-session          # <slot>/web.sock (group-visible) and <slot>/private/ (sockets, 0700); slot is vm0, vm1, ...
captures = /srv/store/sandbox/captures    # <session id>/NN-<kind>-<lang>.png + captures.json
web_group = agino-admin                   # group of web.sock (the platform's group)
max_sessions = 2                          # also enforced by agino-session-ctl
run_minutes = 30                          # unused (the VM is reused for many apps); accepted for old configs
idle_minutes = 10                         # without a key or pointer event
total_minutes = 120                       # hard limit of the whole session; one extension of 30 minutes
install_minutes = 15                      # install limit per app
overlay_cap_gib = 12                      # the one overlay (snapshot state included)
min_free_gib = 20                         # free space in [sandbox] run below this refuses to start
max_captures = 40
retention_hours = 24                      # `session cleanup` removes older captures directories
traffic_cap_gib = 2                       # tap rx+tx per session
