# agino-store-server configuration (docs/server.md section 2). No secrets: the signing key is only a path.
[paths]
content = /srv/store/content          # store-content checkout
state = /srv/store/state
downloads = /srv/store/downloads      # debs: <sha256>/<original file name>
preview = /srv/store/preview          # generated catalogs: catalog-<serial>/ and current -> catalog-<serial>
reports = /srv/store/reports          # reports pulled back from the sandbox host
sandbox_queue = /srv/store/sandbox/queue   # optional; debs + JSON for the sandbox host (group agino-sandbox, setgid)
shots_out = /srv/store/sandbox/shots-out   # optional; where the sandbox host writes screenshots (read-only for the server)
metrics = /var/lib/prometheus/node-exporter

[milkyway]
url = https://repo.aginoos.com        # dists/milkyway/<component>/binary-{amd64,all}/Packages.gz
suite = milkyway
components = main contrib non-free
arch = amd64

[catalog]
# Exactly one of key and sign_command. The server process must not read the signing key:
# sign_command runs the helper as the separate user agino-store-sign (docs/server.md section 8).
sign_command = sudo -n -u agino-store-sign /usr/local/bin/agino-store-sign preview
#key = /etc/agino-store-server/keys/preview.pem   # Ed25519 private key (PEM); tests and VM experiments only
deb_base_url = http://51.38.63.36:8080/store-preview/debs/
valid_days = 14
renew_after_hours = 20
keep_catalogs = 3

[fetch]
user_agent = agino-store-server/0.1 (+https://aginoos.com)
min_interval_seconds = 1
max_deb_bytes = 2147483648
max_index_bytes = 134217728
# Test only: allow http:// and file:// (tests and VM experiments). The command line refuses to run with this
# set unless AGINO_STORE_SERVER_TESTS=1 is in the environment.
allow_insecure = false

[reports]
# Directory of *.pub files, one per sandbox host: one line, base64 of the raw 32-byte Ed25519 public key.
# Every report <name>.json needs <name>.json.sig (base64 signature over the raw JSON bytes).
keys = /etc/agino-store-server/sandbox-keys

[upstream]
# Hosts an upstream repo (upstreams/<id>.yaml) or a tarball source may live on; https only (docs/server.md section 14).
allowed_hosts = github.com gitlab.com codeberg.org invent.kde.org gitlab.gnome.org
check_interval_hours = 6          # informational: the interval of agino-store-upstream-check.timer

[builds]
queue = /srv/store/build-queue    # agino-store writes task.json + source.tar; group agino-sandbox reads (0750)
out = /srv/store/build-out        # the build runner (agino-sandbox) writes status.json, build.log, result.json, *.deb
max_concurrent = 1
limits = cpu_minutes=90 memory_gib=8 disk_gib=20   # ceilings; a recipe may only lower them
max_source_mib = 512
max_artifact_mib = 1024
max_log_mib = 8

[intake]
# AI source intake (docs/server.md section 15). The whole section is optional; these are the defaults.
agents = claude                   # AI agents that are set up (claude, codex); the first one is the default
switch_agent = no                 # yes: after a model service failure the next agent takes over; no: the task pauses and retries
ai_minutes = 120                  # time limit of one AI task, 10..600
max_rounds = 3                    # corrections after a bad delivery or a failed replay, 0..10
model_retry_minutes = 5           # pause after a model service failure, 1..1440
model_max_retries = 12            # retries before the task fails
auto_repair = yes                 # open a repair task when a recipe stops building (at most max_auto_repairs per version)
max_auto_repairs = 2
max_unfinished = 20               # open intake tasks at once
proxy_allow_file = /srv/store/builder-proxy/allow-extra.list   # extra hosts for the builder's forwarding proxy; rewritten by every intake-step
max_page_kib = 1024               # one fetched page
max_inputs_mib = 8                # everything handed to the agent
keep_days = 14                    # working files of finished tasks
