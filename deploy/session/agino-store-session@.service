[Unit]
Description=agino app store: interactive screenshot session for %i
After=network-online.target agino-sandbox-net.service agino-sandbox-dhcp.service
Wants=network-online.target
Requires=agino-sandbox-net.service agino-sandbox-dhcp.service

[Service]
# One session per instance. The instance name is the slot (vm0, vm1, ...; ^vm[0-9]$), chosen by
# agino-session-ctl and validated again by the daemon; it is used as %i only (never %I).
# Run directory: /run/agino-session/<slot>/.
Type=simple
User=agino-sandbox
# No SupplementaryGroups=agino-admin: qemu inherits the daemon's groups, and an escaped guest must not reach the
# admin sockets. web.sock gets its group from the setgid /run/agino-session (tmpfiles.d). kvm comes with the user.
ExecStart=/usr/local/bin/agino-store-sandbox --config /etc/agino-store-sandbox/sandbox.conf session serve %i
# Hard limit: total_minutes (120) + one extension (30) + 5 min clean-up. Never restarted: a session is not resumable.
RuntimeMaxSec=9300
Restart=no
TimeoutStopSec=30
KillMode=control-group
Nice=10
UMask=0077
# No RuntimeDirectory=: its group would be the unit's, not agino-admin (tmpfiles.d creates /run/agino-session).
# Hardening, same as agino-store-sandbox.service. /dev/kvm and /dev/net/tun are used, so PrivateDevices stays off.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/store/sandbox /run/agino-session
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/random r
